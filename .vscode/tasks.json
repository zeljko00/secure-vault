{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker Compose: Dev Up",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.dev.yml",
        "up",
        "--remove-orphans"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Docker Compose: Down",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--profile",
        "migration",
        "--profile",
        "monitoring",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.dev.yml",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Docker Compose: Dev Up (with monitoring)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--profile",
        "monitoring",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.dev.yml",
        "up",
        "--remove-orphans"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Docker Compose: Dev Up (with migration)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--profile",
        "migration",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.dev.yml",
        "up",
        "--remove-orphans"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}